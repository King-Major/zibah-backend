# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Number of reverse proxies in front of the app (Render/Railway/Heroku/Fly = 1).
# REQUIRED in production, otherwise rate limiting treats every user as one IP.
# Leave blank for local dev.
TRUST_PROXY=

# ─── MongoDB (REQUIRED) ──────────────────────────────────
# Atlas: Connect > Drivers > copy the string, add the DB name before the "?"
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/zibah_stores?retryWrites=true&w=majority
# Local alternative: mongodb://127.0.0.1:27017/zibah_stores

# ─── Auth (REQUIRED) ─────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── URLs ────────────────────────────────────────────────
# Your React app. Used for CORS, Paystack callback (/verify) and email links.
FRONTEND_URL=http://localhost:5173
# Public URL of THIS API (used in the email-verification link).
BACKEND_URL=http://localhost:5000
# Optional: comma-separated extra allowed origins (defaults to FRONTEND_URL)
CORS_ORIGINS=

# ─── Paystack ────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# ─── Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (email) ──────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be on a domain verified in Resend (onboarding@resend.dev only sends to your own email)
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# ─── One-time seed scripts only (npm run seed:admin) ─────
ADMIN_EMAIL=
ADMIN_PASSWORD=
